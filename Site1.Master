<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site1.master.vb" Inherits="Billet_de_Bus.Site1" %>
<!DOCTYPE html>
<html lang="fr">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BilletBus</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: Segoe UI, Arial, sans-serif; margin: 0; background: #f3f5f9; color: #1f2937; }
        header { background: #0b3d91; color: #fff; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; height: 56px; }
        header .logo { font-size: 20px; font-weight: 700; }
        header nav a { color: #fff; text-decoration: none; margin-left: 18px; font-size: 14px; }
        header nav a:hover { text-decoration: underline; }
        main { max-width: 960px; margin: 24px auto; padding: 0 16px; }
        .carte { background: #fff; border-radius: 8px; padding: 20px; margin-bottom: 20px; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
        h2 { margin-top: 0; color: #0b3d91; }
        label { display: block; margin: 10px 0 4px; font-size: 13px; font-weight: 600; }
        input[type=text], input[type=password], input[type=email], input[type=number], input[type=datetime-local], select {
            width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; }
        .btn { background: #0b3d91; color: #fff; border: 0; border-radius: 6px; padding: 9px 18px; cursor: pointer; font-size: 14px; margin-top: 14px; }
        .btn:hover { background: #082c6b; }
        .btn-danger { background: #b91c1c; margin-top: 0; padding: 5px 10px; }
        .btn-petit { margin-top: 0; padding: 5px 12px; }
        .msg-ok { color: #166534; background: #dcfce7; padding: 8px 12px; border-radius: 6px; margin: 10px 0; display: block; }
        .msg-err { color: #991b1b; background: #fee2e2; padding: 8px 12px; border-radius: 6px; margin: 10px 0; display: block; }
        table.grille { width: 100%; border-collapse: collapse; font-size: 14px; }
        table.grille th { background: #0b3d91; color: #fff; text-align: left; padding: 8px; }
        table.grille td { padding: 8px; border-bottom: 1px solid #e5e7eb; }
        .ligne { display: flex; gap: 12px; flex-wrap: wrap; }
        .ligne > div { flex: 1; min-width: 160px; }
        .formulaire { max-width: 440px; margin: 0 auto; }
    </style>
</head>
<body>
<form id="form1" runat="server">
    <header>
        <div class="logo">&#128652; BilletBus</div>
        <nav>
            <asp:HyperLink runat="server" NavigateUrl="~/Default.aspx" Text="Accueil" />
            <asp:HyperLink ID="lnkInscription" runat="server" NavigateUrl="~/Inscription.aspx" Text="Inscription" />
            <asp:HyperLink ID="lnkConnexion" runat="server" NavigateUrl="~/Connexion.aspx" Text="Connexion" />
            <asp:HyperLink ID="lnkAdmin" runat="server" NavigateUrl="~/Admin.aspx" Text="Administration" Visible="false" />
            <asp:Label ID="lblUtilisateur" runat="server" Visible="false" style="margin-left:18px;font-size:14px;" />
            <asp:LinkButton ID="lnkDeconnexion" runat="server" Text="Déconnexion" Visible="false" OnClick="lnkDeconnexion_Click" CausesValidation="false" />
        </nav>
    </header>
    <main>
        <asp:ContentPlaceHolder ID="Contenu" runat="server" />
    </main>
</form>
</body>
</html>
